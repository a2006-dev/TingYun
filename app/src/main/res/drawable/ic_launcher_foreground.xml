<?xml version="1.0" encoding="utf-8"?>
<!--
  停云 · 图标前景
  意象：停住的云 + 落下的雨线。全部用 path，不依赖位图（10.1 图标与启动）。

  安全区（10.1）：108dp 画布，各家 Launcher 会裁成不同形状，
  关键图形必须落在中心 66dp 直径圆内 —— 即以 (54,54) 为圆心、半径 33 的圆。
  本图内容包围盒 x:35..69.4、y:39.5..72，
  四角到圆心的最远距离 ≈ sqrt(19² + 18²) ≈ 26.2 < 33，任何裁切形状都不会切掉云或雨线。
  另：monochrome 也用本图，所以只用单一颜色 + alpha，不用渐变。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 云：一条平缓的停云，不画成卡通云 -->
    <path
        android:pathData="M35,50 C35,43.6 40.4,39 47,39 C50,39 52.8,40.3 54.8,42.5 C56.2,40.6 58.5,39.5 60.9,39.5 C65.6,39.5 69.4,43.3 69.4,48 C69.4,48.7 69.3,49.3 69.1,50 L35,50 Z"
        android:fillColor="#EEF3FA"
        android:fillAlpha="0.92" />

    <!-- 雨线：三根，长短错落，表达「濛濛时雨」 -->
    <path
        android:pathData="M46,56.5 L46,66.5"
        android:strokeColor="#EEF3FA"
        android:strokeWidth="2.4"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,56.5 L54,72"
        android:strokeColor="#EEF3FA"
        android:strokeWidth="2.4"
        android:strokeAlpha="0.75"
        android:strokeLineCap="round" />
    <path
        android:pathData="M62,56.5 L62,64.5"
        android:strokeColor="#EEF3FA"
        android:strokeWidth="2.4"
        android:strokeAlpha="0.4"
        android:strokeLineCap="round" />
</vector>